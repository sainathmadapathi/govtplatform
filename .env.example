# GovOS server settings. Copy this file to `.env` (which is never committed) and edit the copy.
#
# Only GOVOS_* settings and PORT are read from .env; any other line is ignored by the server.
#
# There is no API key setting. GovOS reaches Claude only through the Claude CLI installed on this
# machine, and the CLI authenticates with your own account login. Sign in once, in a terminal:
#
#     claude auth login
#
# Never put an Anthropic or OpenAI API key, or any other secret, in this file. See
# CLAUDE_CLI_INTEGRATION.md for what runs through Claude, what does not, and the usage this
# consumes on your account.

# Master switch. Off by default: with it off, GovOS runs on its deterministic logic alone and every
# Claude feature reports "disabled" instead of failing. Set to 1 to turn the integration on.
GOVOS_CLAUDE_ENABLED=0

# Optional. Absolute path to the Claude CLI executable when it is not on PATH. It must be the
# native `claude` executable (claude.exe on Windows), not a .cmd shim.
# GOVOS_CLAUDE_CLI_PATH=

# Seconds one Claude call may run before the whole process tree is stopped (10-900, default 120).
# Web discovery is allowed a multiple of this.
# GOVOS_CLAUDE_TIMEOUT_SECONDS=120

# How many Claude calls may run at once (1-4, default 2). Each is a separate CLI process.
# GOVOS_CLAUDE_MAX_CONCURRENCY=2

# The largest reply accepted from the CLI, in bytes (default 262144). Larger output is rejected.
# GOVOS_CLAUDE_MAX_OUTPUT_BYTES=262144

# Optional. An empty directory the CLI runs in. Default: a scratch directory outside this repository,
# so the CLI never sees the project's files or instructions.
# GOVOS_CLAUDE_JOB_WORKDIR=

# Optional. A model alias for the CLI (default: the CLI's own default).
# GOVOS_CLAUDE_MODEL=

# Protects the Trust Panel operations that spend Claude usage or change canonical information
# (discovery, extraction, builds, revisions). Unset, they are accepted only from this machine
# itself. Set it (to a long random value) before exposing the server through a proxy; the browser
# then sends it as the X-GovOS-Admin-Token header. This is a local guard, not user authentication.
# GOVOS_CLAUDE_ADMIN_TOKEN=

# The port python app.py listens on (default 5000).
# PORT=5000
